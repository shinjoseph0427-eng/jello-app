{
  "expo": {
    "name": "Jello",
    "slug": "jello-two-sides",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/jello-app-icon.png",
    "scheme": "jello",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/jello-app-icon.png",
      "bundleIdentifier": "app.jello.twosides",
      "associatedDomains": ["applinks:jello-two-sides.expo.app"],
      "supportsTablet": false,
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Jello uses the camera to create a Two Sides moment with a friend.",
        "NSContactsUsageDescription": "Jello uses your contacts to help you invite friends. Contacts stay on your device and are not posted publicly.",
        "NSPhotoLibraryAddUsageDescription": "Jello saves completed Two Sides moments when you choose to export them."
      }
    },
    "android": {
      "package": "app.jello.twosides",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-dev-client",
      "expo-apple-authentication",
      "expo-web-browser",
      "expo-secure-store",
      "expo-contacts",
      [
        "expo-camera",
        {
          "cameraPermission": "Jello uses the camera to create a Two Sides moment with a friend.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#FFB84D",
          "defaultChannel": "moments"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B0B0C",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-widgets",
        {
          "bundleIdentifier": "app.jello.twosides.widgets",
          "groupIdentifier": "group.app.jello.twosides",
          "widgets": [
            {
              "name": "JelloMomentWidget",
              "displayName": "Jello Two Sides",
              "description": "Keep your latest completed moment close.",
              "supportedFamilies": ["systemSmall", "systemMedium"],
              "contentMarginsDisabled": true,
              "ios": {
                "supportedFamilies": ["systemSmall", "systemMedium"],
                "contentMarginsDisabled": true
              },
              "android": null
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "307a90b0-4ac0-4b74-9434-9eb4fba5a459"
      }
    },
    "owner": "shinjoseph0427",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/307a90b0-4ac0-4b74-9434-9eb4fba5a459"
    }
  }
}
